# Copy to .env next to compose.prod.yaml on the server and fill in real values.
# compose.local.yaml needs none of these (dev defaults, console email backend).

# Django
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PORTFOLIO_BLOG_SECRET_KEY=change-me

# PostgreSQL
POSTGRES_DB=portfolio_blog
POSTGRES_USER=portfolio_blog
POSTGRES_PASSWORD=change-me

# Email (SMTP) - used by the contact form
EMAIL_HOST=
# 587 + TLS (the default when unset), or 465 + SSL
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=victorngeno@baruamail.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=victorngeno@baruamail.com
