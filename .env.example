# Copy to .env next to compose.prod.yaml on the server and fill in real values.
# compose.local.yaml needs none of these (it has dev defaults).

# Django
PORTFOLIO_BLOG_SECRET_KEY=change-me  # python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# PostgreSQL
POSTGRES_DB=portfolio_blog
POSTGRES_USER=portfolio_blog
POSTGRES_PASSWORD=change-me

# Email (optional - contact form / admin mails)
EMAIL_HOST=
EMAIL_HOST_PASSWORD=
